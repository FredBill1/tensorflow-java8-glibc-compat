<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.fredbill1</groupId>
  <artifactId>tensorflow-java8-glibc-compat</artifactId>
  <version>1.2.0-compat.1</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tensorflow.compat.build.directory>${compat.project.root}/target</tensorflow.compat.build.directory>
    <tensorflow.java.version>1.2.0</tensorflow.java.version>
    <tensorflow.runtime.version>2.21.0</tensorflow.runtime.version>
    <javacpp.version>1.5.12</javacpp.version>
    <protobuf.version>4.31.1</protobuf.version>
    <tensorflow.sources.directory>${project.build.directory}/generated-sources/tensorflow</tensorflow.sources.directory>
    <tensorflow.source.jars.directory>${project.build.directory}/tensorflow-source-jars/${tensorflow.java.version}</tensorflow.source.jars.directory>
    <tensorflow.sources.api.sha256>4991a35fae531d1b827f93d374c04374171fdac42bbc08663c5b8e7c55ce6a92</tensorflow.sources.api.sha256>
    <tensorflow.sources.native.sha256>d2ab05a77f64ce8bd627898490700aecb0dadd957908a330e24fd32db0e9e467</tensorflow.sources.native.sha256>
    <tensorflow.sources.ndarray.sha256>d0f0220db76b5d6c760051ade1a2c83b34934d943ef4f94721ae946c198366d5</tensorflow.sources.ndarray.sha256>
    <project.build.outputTimestamp>2026-10-31T00:00:00Z</project.build.outputTimestamp>
    <compat.project.root>${project.basedir}</compat.project.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tensorflow</groupId>
      <artifactId>tensorflow-core-native</artifactId>
      <version>${tensorflow.java.version}</version>
      <classifier>linux-x86_64</classifier>
    </dependency>
    <dependency>
      <groupId>org.tensorflow</groupId>
      <artifactId>tensorflow-core-native</artifactId>
      <version>${tensorflow.java.version}</version>
      <classifier>linux-arm64</classifier>
    </dependency>
  </dependencies>
  <build>
    <directory>${tensorflow.compat.build.directory}</directory>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>tensorflow-sources</id>
            <phase>process-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${tensorflow.sources.directory}</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>attach-patched-sources</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/${project.build.finalName}-sources.jar</file>
                  <type>jar</type>
                  <classifier>sources</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>8</source>
          <target>8</target>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>prepare-tensorflow-native</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <workingDirectory>${compat.project.root}</workingDirectory>
              <arguments>
                <argument>${compat.project.root}/scripts/prepare-tensorflow-native.py</argument>
                <argument>--project-root</argument>
                <argument>${compat.project.root}</argument>
                <argument>--build-directory</argument>
                <argument>${project.build.directory}</argument>
                <argument>--classes-directory</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>--maven-repository</argument>
                <argument>${settings.localRepository}</argument>
                <argument>--tensorflow-java-version</argument>
                <argument>${tensorflow.java.version}</argument>
                <argument>--tensorflow-runtime-version</argument>
                <argument>${tensorflow.runtime.version}</argument>
                <argument>--javacpp-version</argument>
                <argument>${javacpp.version}</argument>
                <argument>--protobuf-version</argument>
                <argument>${protobuf.version}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>collect-third-party-licenses</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${compat.project.root}/scripts/collect_licenses.py</argument>
                <argument>--project-root</argument>
                <argument>${compat.project.root}</argument>
                <argument>--build-directory</argument>
                <argument>${project.build.directory}</argument>
                <argument>--classes-directory</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>--maven-repository</argument>
                <argument>${settings.localRepository}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>create-patched-sources-jar</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${compat.project.root}/scripts/create_sources.py</argument>
                <argument>--project-root</argument>
                <argument>${compat.project.root}</argument>
                <argument>--build-directory</argument>
                <argument>${project.build.directory}</argument>
                <argument>--classes-directory</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>--output</argument>
                <argument>${project.build.directory}/${project.build.finalName}-sources.jar</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-compatibility-jar</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${compat.project.root}/scripts/verify_jar.py</argument>
                <argument>--jar</argument>
                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>com.google.protobuf</pattern>
                  <shadedPattern>io.github.fredbill1.tensorflow.compat.shaded.protobuf</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.tensorflow:tensorflow-core-native</artifact>
                  <excludes>
                    <exclude>org/tensorflow/internal/c_api/linux-x86_64/libjnitensorflow.so</exclude>
                    <exclude>org/tensorflow/internal/c_api/linux-x86_64/libtensorflow_cc.so.2</exclude>
                    <exclude>org/tensorflow/internal/c_api/linux-x86_64/libtensorflow_framework.so.2</exclude>
                    <exclude>org/tensorflow/internal/c_api/linux-arm64/libjnitensorflow.so</exclude>
                    <exclude>org/tensorflow/internal/c_api/linux-arm64/libtensorflow_cc.so.2</exclude>
                    <exclude>org/tensorflow/internal/c_api/linux-arm64/libtensorflow_framework.so.2</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <TensorFlow-Java-Version>${tensorflow.java.version}</TensorFlow-Java-Version>
                    <TensorFlow-Runtime-Version>${tensorflow.runtime.version}</TensorFlow-Runtime-Version>
                    <Implementation-Title>${project.artifactId}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>download-tensorflow-sources</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.tensorflow</groupId>
                  <artifactId>tensorflow-core-api</artifactId>
                  <version>${tensorflow.java.version}</version>
                  <classifier>sources</classifier>
                  <type>jar</type>
                  <destFileName>core-api-sources.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.tensorflow</groupId>
                  <artifactId>tensorflow-core-native</artifactId>
                  <version>${tensorflow.java.version}</version>
                  <classifier>sources</classifier>
                  <type>jar</type>
                  <destFileName>core-native-sources.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.tensorflow</groupId>
                  <artifactId>tensorflow-ndarray</artifactId>
                  <version>${tensorflow.java.version}</version>
                  <classifier>sources</classifier>
                  <type>jar</type>
                  <destFileName>ndarray-sources.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${tensorflow.source.jars.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>prepare-tensorflow-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant antfile="${compat.project.root}/scripts/prepare-tensorflow-sources.xml" dir="${compat.project.root}" target="prepare">
                  <property name="project.build.directory" value="${project.build.directory}" />
                  <property name="project.build.outputDirectory" value="${project.build.outputDirectory}" />
                  <property name="project.build.testOutputDirectory" value="${project.build.testOutputDirectory}" />
                  <property name="tensorflow.java.version" value="${tensorflow.java.version}" />
                  <property name="tensorflow.sources.directory" value="${tensorflow.sources.directory}" />
                  <property name="tensorflow.source.jars.directory" value="${tensorflow.source.jars.directory}" />
                  <property name="tensorflow.sources.api.sha256" value="${tensorflow.sources.api.sha256}" />
                  <property name="tensorflow.sources.native.sha256" value="${tensorflow.sources.native.sha256}" />
                  <property name="tensorflow.sources.ndarray.sha256" value="${tensorflow.sources.ndarray.sha256}" />
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>${compat.project.root}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
          <include>THIRD_PARTY_NOTICES.md</include>
        </includes>
      </resource>
    </resources>
  </build>
  <name>TensorFlow Java 8 glibc Compatibility</name>
  <description>Java 8 API and low-ABI JNI rebuild of TensorFlow Java with unchanged official CPU runtime libraries.</description>
  <url>https://github.com/fredbill1/tensorflow-java8-glibc-compat</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
</project>